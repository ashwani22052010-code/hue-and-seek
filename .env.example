# Copy to server/.env (or set in your hosting provider's dashboard). Never commit real secrets.

# HTTP + WebSocket port
PORT=3001

# PostgreSQL connection string. Leave empty to use the embedded PGlite database (local dev only),
# which stores data in PGLITE_DIR.
DATABASE_URL=
# DATABASE_URL=postgres://hue:change-me@localhost:5432/hueandseek

# Set to true for managed Postgres that requires TLS (Supabase, Render, Railway, Neon, ...)
DATABASE_SSL=false

# Embedded database location when DATABASE_URL is empty ("memory" = throwaway in-memory DB)
PGLITE_DIR=./data/pglite

# Comma-separated allowed origins if the client is hosted on a different domain than the server.
# Leave empty when the server also serves the client (recommended).
CORS_ORIGIN=

# Set to true when running behind a reverse proxy / load balancer so rate limits see real client IPs.
TRUST_PROXY=false

# Session lifetime in days
SESSION_DAYS=60

# Testing only: shorten phase timers (FAST_TIMERS=true => x0.25) or scale them explicitly.
FAST_TIMERS=false
# TIMER_SCALE=1
